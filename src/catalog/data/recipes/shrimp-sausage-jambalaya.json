  "steps": [
    {
      "text": "Brown the sausage in the oil in a large pot over medium-high heat, about 5 minutes.",
      "uses": ["sausage", "oil"],
      "timerMinutes": 5
    },
    {
      "text": "Add the onion, pepper and celery and cook until soft, about 5 minutes.",
      "uses": ["onion", "pepper", "celery"],
      "timerMinutes": 5
    },
    {
      "text": "Stir in the garlic, paprika and oregano for 1 minute.",
      "uses": ["garlic", "paprika", "oregano"]
    },
    {
      "text": "Add the rice, tomatoes and broth. Bring to a boil, then cover, turn the heat to low and cook for 18 minutes.",
      "uses": ["rice", "tomatoes", "broth"],
      "timerMinutes": 18
    },
    {
      "text": "Tuck the shrimp into the rice, cover again and cook until pink, about 5 minutes. Scatter with green onions.",
