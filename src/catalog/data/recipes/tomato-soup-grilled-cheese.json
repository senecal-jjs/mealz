  "steps": [
    {
      "text": "Melt 2 tbsp butter in a pot over medium heat. Cook the onion until soft, about 6 minutes, then add the garlic for 1 minute.",
      "uses": ["butter-soup", "onion", "garlic"],
      "timerMinutes": 6
    },
    {
      "text": "Add the tomatoes, broth, sugar and a good pinch of salt and pepper. Simmer for 15 minutes.",
      "uses": ["tomatoes", "broth", "sugar", "salt", "pepper"],
      "timerMinutes": 15
    },
    {
      "text": "Meanwhile, butter one side of each bread slice. Make 4 sandwiches with the cheddar inside and the buttered sides out.",
      "uses": ["bread", "cheddar", "butter-bread"]
    },
    {
      "text": "Cook the sandwiches in a skillet over medium-low heat until deep golden and melted, 3 to 4 minutes per side.",
      "uses": []
    },
    {
      "text": "Blend the soup until smooth (an immersion blender is easiest), stir in the cream and season to taste. Serve with the sandwiches cut into strips.",
      "uses": ["cream"]
    }
  ]
