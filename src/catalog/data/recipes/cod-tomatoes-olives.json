  "steps": [
    {
      "text": "Heat the oven to 425°F (220°C). In a baking dish, toss the tomatoes, olives and garlic with 2 tbsp oil, the oregano and a pinch of salt. Roast for 10 minutes, until the tomatoes start to burst.",
      "uses": ["tomatoes", "olives", "garlic", "oil", "oregano", "salt"],
      "timerMinutes": 10
    },
    {
      "text": "Pat the cod dry, season with salt and pepper and nestle it into the tomatoes. Drizzle with the rest of the oil and add a few lemon slices.",
      "uses": ["cod", "pepper", "lemon"]
    },
    {
      "text": "Roast until the fish flakes easily, 10 to 12 minutes.",
      "uses": [],
      "timerMinutes": 11
    },
    {
      "text": "Scatter with parsley and serve with bread to soak up the juices.",
      "uses": ["parsley", "bread"]
    }
  ]
