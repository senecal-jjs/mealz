  "steps": [
    {
      "text": "Heat the oven to 425°F. Toss the sweet potato wedges with the oil, paprika and salt on a sheet pan and roast, turning once, until browned, about 25 minutes.",
      "uses": ["potatoes", "oil", "paprika", "salt"],
      "timerMinutes": 25
    },
    {
      "text": "Mix the turkey with the mustard, panko and a pinch of salt and shape into 4 patties.",
      "uses": ["turkey", "mustard", "panko"]
    },
    {
      "text": "Cook the patties in a lightly oiled skillet over medium heat until cooked through, about 5 minutes per side, topping with cheddar for the last minute.",
      "uses": ["cheddar"],
      "timerMinutes": 10
    },
    {
      "text": "Serve on the buns with lettuce and the wedges alongside.",
      "uses": ["buns", "lettuce"]
    }
  ]
