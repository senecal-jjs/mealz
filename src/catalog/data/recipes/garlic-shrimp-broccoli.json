  "steps": [
    {
      "text": "Whisk the soy sauce, vinegar and cornstarch with ¼ cup water.",
      "uses": ["soy", "vinegar", "cornstarch"]
    },
    {
      "text": "Heat the oil in a wok or large skillet over high heat. Add the broccoli and 2 tablespoons water, cover and cook for 3 minutes.",
      "uses": ["oil", "broccoli"],
      "timerMinutes": 3
    },
    {
      "text": "Add the shrimp, garlic and ginger and stir-fry until the shrimp are pink, about 3 minutes. Pour in the sauce and let it bubble until glossy.",
      "uses": ["shrimp", "garlic", "ginger"],
      "timerMinutes": 3
    },
    {
      "text": "Meanwhile, cook the cauliflower rice in the microwave or a pan as the package directs, about 4 minutes.",
      "uses": ["caulirice"],
      "timerMinutes": 4
    },
    {
      "text": "Drizzle the stir-fry with sesame oil, scatter with green onions and serve over the cauliflower rice.",
