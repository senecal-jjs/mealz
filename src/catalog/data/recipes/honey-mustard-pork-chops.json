  "steps": [
    {
      "text": "Heat the oven to 425°F (220°C). Toss the carrots with 1 tbsp oil and a pinch of salt and pepper on a sheet pan and roast for 10 minutes.",
      "uses": ["carrots", "oil", "salt", "pepper"],
      "timerMinutes": 10
    },
    {
      "text": "Stir together the mustard, honey, garlic and thyme.",
      "uses": ["mustard", "honey", "garlic", "thyme"]
    },
    {
      "text": "Rub the pork chops with the remaining oil and season with salt and pepper. Push the carrots to the edges, add the chops to the pan and brush the tops with half the glaze. Roast until the pork reaches 145°F (63°C), 12 to 15 minutes.",
      "uses": ["pork"],
      "timerMinutes": 13
    },
