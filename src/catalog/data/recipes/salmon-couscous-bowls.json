  "steps": [
    {
      "text": "Heat the oven to 425°F. Rub the salmon with the oil, paprika and salt and roast on a lined sheet until it flakes, about 12 minutes.",
      "uses": ["salmon", "oil", "paprika", "salt"],
      "timerMinutes": 12
    },
    {
      "text": "Bring the broth to a boil, pour it over the couscous in a bowl, cover and leave for 5 minutes. Fluff with a fork and the juice of half the lemon.",
      "uses": ["broth", "couscous", "lemon"],
      "timerMinutes": 5
    },
    {
      "text": "Stir the yogurt with the garlic, a squeeze of lemon and a pinch of salt.",
      "uses": ["yogurt", "garlic"]
    },
    {
      "text": "Divide the couscous between bowls with the cucumber, tomatoes and flaked salmon. Spoon over the yogurt sauce and scatter with parsley.",
      "uses": ["cucumber", "tomatoes", "parsley"]
    }
