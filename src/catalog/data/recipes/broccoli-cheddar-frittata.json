  "steps": [
    {
      "text": "Heat the oven to 400°F. Whisk the eggs with the milk, salt and pepper.",
      "uses": ["eggs", "milk", "salt", "pepper"]
    },
    {
      "text": "Heat the oil in a 10-inch ovenproof skillet over medium heat. Cook the broccoli and green onions with a splash of water until bright green, about 4 minutes.",
      "uses": ["oil", "broccoli", "scallions"],
      "timerMinutes": 4
    },
    {
      "text": "Pour in the eggs, scatter over the cheddar and cook without stirring until the edges set, about 2 minutes.",
      "uses": ["cheddar"],
      "timerMinutes": 2
    },
    {
      "text": "Bake until puffed and just set in the middle, about 12 minutes. Cut into wedges and serve with the tomatoes.",
