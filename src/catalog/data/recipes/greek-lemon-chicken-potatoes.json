  "steps": [
    {
      "text": "Heat the oven to 425°F (220°C). Whisk the oil, the juice of 1 lemon, the garlic, oregano, 1½ tsp salt and plenty of pepper.",
      "uses": ["oil", "lemon", "garlic", "oregano", "salt", "pepper"]
    },
    {
      "text": "Toss the potatoes and onion with half of the marinade on a sheet pan and roast for 15 minutes.",
      "uses": ["potatoes", "onion"],
      "timerMinutes": 15
    },
    {
      "text": "Toss the chicken in the remaining marinade. Nestle it among the potatoes with slices of the second lemon, and roast until the chicken reaches 165°F (74°C) and the potatoes are golden, about 20 minutes.",
      "uses": ["chicken"],
      "timerMinutes": 20
    },
    {
      "text": "Crumble the feta over the top before serving.",
      "uses": ["feta"]
    }
  ]
