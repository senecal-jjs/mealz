  "steps": [
    {
      "text": "Heat the oil in a skillet over medium heat and cook the onion until soft, about 5 minutes.",
      "uses": ["oil", "onion"],
      "timerMinutes": 5
    },
    {
      "text": "Stir in the garlic, cumin and chili powder for 30 seconds. Add the beans and ¼ cup water, mash about half of them with a fork and simmer until thick, about 5 minutes.",
      "uses": ["garlic", "cumin", "chili", "beans"],
      "timerMinutes": 5
    },
    {
      "text": "Meanwhile, toss the cabbage and cilantro with the juice of 1 lime and a pinch of salt. Cut the other lime into wedges.",
      "uses": ["cabbage", "cilantro", "lime", "salt"]
    },
    {
      "text": "Warm the tortillas in a dry skillet or directly over a gas flame until lightly charred, about 30 seconds per side.",
      "uses": ["tortillas"]
    },
    {
      "text": "Fill the tortillas with beans, slaw and avocado and serve with lime wedges.",
      "uses": ["avocado"]
    }
  ]
