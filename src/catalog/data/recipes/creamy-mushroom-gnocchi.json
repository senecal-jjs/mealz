  "steps": [
    {
      "text": "Heat the oil and 1 tbsp butter in a large skillet over medium-high heat. Add the gnocchi in a single layer and cook undisturbed until golden, about 3 minutes. Toss and cook 3 minutes more, then move to a plate.",
      "uses": ["oil", "butter", "gnocchi"],
      "timerMinutes": 6
    },
    {
      "text": "Melt the remaining butter. Cook the mushrooms with a pinch of salt until browned and their liquid has cooked off, 6 to 8 minutes.",
      "uses": ["mushrooms", "salt"],
      "timerMinutes": 8
    },
    {
      "text": "Stir in the garlic and thyme for 1 minute. Pour in the broth and cream and simmer until slightly thickened, about 3 minutes.",
      "uses": ["garlic", "thyme", "broth", "cream"],
      "timerMinutes": 3
    },
    {
      "text": "Stir in the spinach until wilted, then the gnocchi and parmesan. Season with black pepper.",
      "uses": ["spinach", "parmesan", "pepper"]
    }
  ]
