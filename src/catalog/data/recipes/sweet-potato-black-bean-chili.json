  "steps": [
    {
      "text": "Heat the oil in a large pot over medium heat. Cook the onion and bell pepper with a pinch of salt until soft, about 5 minutes.",
      "uses": ["oil", "onion", "pepper", "salt"],
      "timerMinutes": 5
    },
    {
      "text": "Stir in the garlic, chili powder, cumin and paprika for 1 minute.",
      "uses": ["garlic", "chili", "cumin", "paprika"]
    },
    {
      "text": "Add the sweet potatoes, beans, tomatoes and broth. Bring to a boil, then cover and simmer until the sweet potatoes are tender, about 20 minutes.",
      "uses": ["potatoes", "beans", "tomatoes", "broth"],
      "timerMinutes": 20
    },
    {
      "text": "Mash a few pieces of sweet potato against the side of the pot to thicken the chili. Stir in the juice of the lime and season with salt.",
      "uses": ["lime"]
    },
    {
      "text": "Serve topped with avocado and cilantro.",
      "uses": ["avocado", "cilantro"]
    }
