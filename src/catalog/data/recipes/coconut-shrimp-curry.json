  "steps": [
    {
      "text": "Rinse the rice, then bring it to a boil with 2¼ cups water and a pinch of salt. Cover, turn the heat to low and cook until the water is absorbed, about 15 minutes. Let it stand off the heat, still covered, while you cook.",
      "uses": ["rice"],
      "timerMinutes": 15
    },
    {
      "text": "Heat the oil in a large skillet over medium heat and cook the onion until soft, about 5 minutes.",
      "uses": ["oil", "onion"],
      "timerMinutes": 5
    },
    {
      "text": "Stir in the garlic, ginger and curry powder for 1 minute.",
      "uses": ["garlic", "ginger", "curry"]
    },
    {
      "text": "Add the tomatoes and coconut milk and simmer for 6 minutes.",
      "uses": ["tomatoes", "coconut"],
      "timerMinutes": 6
    },
    {
      "text": "Add the shrimp and cook until pink, about 3 minutes. Stir in the spinach until wilted and add the juice of the lime.",
      "uses": ["shrimp", "spinach", "lime"],
      "timerMinutes": 3
    },
    {
      "text": "Serve over rice with cilantro.",
      "uses": ["cilantro"]
    }
  ]
