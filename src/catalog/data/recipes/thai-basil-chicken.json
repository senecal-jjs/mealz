  "steps": [
    {
      "text": "Rinse the rice, then bring it to a boil with 2¼ cups water and a pinch of salt. Cover, turn the heat to low and cook until the water is absorbed, about 15 minutes. Let it stand off the heat, still covered, while you cook.",
      "uses": ["rice"],
      "timerMinutes": 15
    },
    {
      "text": "Stir together the oyster sauce, soy sauce, fish sauce, brown sugar and 2 tbsp water.",
      "uses": ["oyster", "soy", "fish", "sugar"]
    },
    {
      "text": "Heat the oil in a wok or large skillet over high heat. Stir-fry the garlic, chilies and shallots for 30 seconds.",
      "uses": ["oil", "garlic", "chili", "shallot"]
    },
    {
      "text": "Add the chicken and cook, breaking it up, until no longer pink, 4 to 5 minutes. Add the green beans and cook 2 minutes more.",
      "uses": ["chicken", "beans"],
      "timerMinutes": 5
    },
    {
      "text": "Pour in the sauce and toss for 1 minute. Take the pan off the heat and fold in the basil until it wilts.",
      "uses": ["basil"]
    },
    {
      "text": "If you like, fry the eggs in a little oil until the edges are crisp. Serve the chicken over the rice, topped with an egg.",
      "uses": ["eggs"]
    }
  ]
