  "steps": [
    {
      "text": "Rinse the rice, then bring it to a boil with 1½ cups water and a pinch of salt. Cover, turn the heat to low and cook until the water is absorbed, about 15 minutes. Let it stand off the heat, still covered, while you cook.",
      "uses": ["rice"],
      "timerMinutes": 15
    },
    {
      "text": "Heat the oil in a skillet over medium heat and cook the onion until soft, about 5 minutes. Add the beans, cumin, chili powder, salt and a splash of water. Cook for 4 minutes, mashing about half the beans.",
      "uses": ["oil", "onion", "beans", "cumin", "chili", "salt"],
      "timerMinutes": 4
    },
    {
      "text": "Stir the juice of the lime into the rice.",
      "uses": ["lime"]
    },
    {
      "text": "Fill each tortilla with rice, beans, salsa and cheddar. Fold in the sides and roll up tightly.",
      "uses": ["tortillas", "salsa", "cheddar"]
    },
    {
      "text": "Toast the burritos seam side down in a dry skillet over medium heat until golden, about 2 minutes per side.",
      "uses": [],
