  "steps": [
    {
      "text": "Mash the beans in a bowl, leaving some chunks. Mix in the onion, garlic, cumin, paprika, ½ tsp salt, the egg and panko. Shape into 4 patties.",
      "uses": ["beans", "onion", "garlic", "cumin", "paprika", "salt", "egg", "panko"]
    },
    {
      "text": "Heat the oil in a large skillet over medium heat. Cook the patties until crisp and heated through, about 5 minutes per side.",
      "uses": ["oil"],
      "timerMinutes": 5
    },
    {
      "text": "Serve on toasted buns with lettuce, avocado and tomatoes.",
