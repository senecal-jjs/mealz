  ],
  "steps": [
    {
      "text": "Heat the oven to 425°F (220°C). Toss the potatoes with the oil, paprika and a pinch of salt and pepper on a sheet pan and roast for 10 minutes.",
      "uses": ["potatoes", "oil", "paprika", "salt", "pepper"],
      "timerMinutes": 10
    },
    {
      "text": "Toss the chicken with half the barbecue sauce and add it to the pan. Roast for 15 minutes.",
      "uses": ["chicken", "bbq"],
      "timerMinutes": 15
    },
    {
      "text": "Brush the chicken with the rest of the sauce, scatter the corn around and dot it with butter. Roast until the chicken is cooked through, about 5 minutes more.",
      "uses": ["corn", "butter"],
      "timerMinutes": 5
    },
    {
      "text": "Top with green onions and serve.",
      "uses": ["scallions"]
    }
  ]
