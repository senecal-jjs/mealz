  "steps": [
    {
      "text": "Cook the spaghetti in salted boiling water until al dente, about 10 minutes. Save ½ cup of the pasta water, then drain.",
      "uses": ["pasta", "salt"],
      "timerMinutes": 10
    },
    {
      "text": "Season the shrimp with salt and pepper. Heat the oil in a large skillet over medium-high heat and cook the shrimp until pink, about 2 minutes per side. Move to a plate.",
      "uses": ["shrimp", "pepper", "oil"]
    },
    {
      "text": "Melt the butter in the pan over medium heat, add the garlic and pepper flakes and cook for 1 minute. Add the broth and the juice of the lemon and simmer for 2 minutes.",
      "uses": ["butter", "garlic", "flakes", "broth", "lemon"]
    },
    {
      "text": "Toss in the pasta, shrimp and parsley with a splash of pasta water until glossy.",
