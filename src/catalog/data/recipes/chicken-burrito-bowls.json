  "steps": [
    {
      "text": "Rinse the rice, then bring it to a boil with 2¼ cups water and a pinch of salt. Cover, turn the heat to low and cook until the water is absorbed, about 15 minutes. Let it stand off the heat, still covered, while you cook.",
      "uses": ["rice"],
      "timerMinutes": 15
    },
    {
      "text": "Season the chicken with the chili powder, cumin and salt. Cook in the oil in a large skillet over medium-high heat until cooked through, about 6 minutes per side. Rest for a few minutes, then slice.",
      "uses": ["chicken", "oil", "chili", "cumin", "salt"],
      "timerMinutes": 12
    },
    {
      "text": "In the same skillet, warm the beans and corn with a pinch of salt for about 3 minutes.",
      "uses": ["beans", "corn"],
      "timerMinutes": 3
    },
    {
      "text": "Fluff the rice with the juice of 1 lime and half the cilantro. Cut the other lime into wedges.",
      "uses": ["lime", "cilantro"]
    },
    {
      "text": "Build bowls of rice, beans and corn, and chicken. Top with salsa, avocado, the rest of the cilantro and lime wedges.",
      "uses": ["salsa", "avocado"]
    }
  ]
