  "steps": [
    {
      "text": "Heat the oven to 400°F. Toss the tomatoes and garlic with the oil, pepper flakes, salt and pepper in a baking dish. Set the feta in the middle and roast until the tomatoes burst, about 30 minutes.",
      "uses": ["tomatoes", "garlic", "oil", "flakes", "salt", "pepper", "feta"],
      "timerMinutes": 30
    },
    {
      "text": "Meanwhile, cook the pasta in salted boiling water until al dente, about 10 minutes. Save ½ cup of the water and drain.",
      "uses": ["pasta"],
      "timerMinutes": 10
    },
    {
      "text": "Mash the feta and tomatoes together, then stir in the pasta, spinach and a splash of the cooking water until the spinach wilts. Tear over the basil.",
      "uses": ["spinach", "basil"]
    }
  ]
