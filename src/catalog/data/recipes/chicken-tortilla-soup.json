  "steps": [
    {
      "text": "Heat 2 tablespoons of the oil in a large pot over medium-high heat. Fry the tortilla strips until crisp, about 4 minutes, and drain on paper towels.",
      "uses": ["oil", "tortillas"],
      "timerMinutes": 4
    },
    {
      "text": "Add the remaining oil and the onion and cook until soft, about 5 minutes.",
      "uses": ["onion"],
      "timerMinutes": 5
    },
    {
      "text": "Stir in the garlic, cumin and chili powder for 1 minute.",
      "uses": ["garlic", "cumin", "chili"]
    },
    {
      "text": "Add the tomatoes, broth and whole chicken breasts. Simmer, covered, until the chicken is cooked, about 15 minutes. Lift it out and shred it.",
      "uses": ["tomatoes", "broth", "chicken"],
      "timerMinutes": 15
    },
    {
      "text": "Return the chicken with the beans and corn and simmer for 3 minutes. Add the juice of the lime.",
      "uses": ["beans", "corn", "lime"],
      "timerMinutes": 3
    },
    {
      "text": "Serve topped with the tortilla strips, avocado and cilantro.",
      "uses": ["avocado", "cilantro"]
    }
  ]
