  "steps": [
    {
      "text": "Heat 1 tbsp oil in a large skillet over medium-high heat. Cook the mushrooms and onion until browned, 6 to 8 minutes.",
      "uses": ["oil", "mushrooms", "onion"],
      "timerMinutes": 7
    },
    {
      "text": "Stir in the cumin, paprika and beans with a pinch of salt. Mash about half the beans with a fork and move the filling to a bowl. Wipe out the pan.",
      "uses": ["cumin", "paprika", "beans", "salt"]
    },
    {
      "text": "Sprinkle cheddar over half of each tortilla, top with filling and more cheese, then fold.",
      "uses": ["tortillas", "cheddar"]
    },
    {
      "text": "Brush the pan with a little of the remaining oil and cook the quesadillas over medium heat until golden and the cheese melts, 2 to 3 minutes per side.",
      "uses": []
    },
    {
      "text": "Cut into wedges and serve with salsa and sour cream.",
      "uses": ["salsa", "sour-cream"]
    }
