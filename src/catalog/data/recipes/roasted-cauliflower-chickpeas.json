  "steps": [
    {
      "text": "Heat the oven to 450°F. Toss the cauliflower and chickpeas with the oil, cumin, paprika and salt on a sheet pan. Roast, stirring once, until browned and tender, about 25 minutes.",
      "uses": ["cauliflower", "chickpeas", "oil", "cumin", "paprika", "salt"],
      "timerMinutes": 25
    },
    {
      "text": "Whisk the tahini with the juice of the lemon, the garlic, a pinch of salt and enough water to make it pourable.",
      "uses": ["tahini", "lemon", "garlic"]
    },
    {
      "text": "Drizzle the tahini over the vegetables, scatter with parsley and serve with warm pitas.",
