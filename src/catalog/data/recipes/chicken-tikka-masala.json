      "quantity": 1.5,
      "unit": "cup"
    },
    {
      "id": "chicken",
      "ingredient": "chicken-thighs",
      "quantity": 1.5,
      "unit": "lb",
      "prep": "cut into bite-size pieces"
    },
    {
      "id": "yogurt",
      "ingredient": "greek-yogurt",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "id": "garam",
      "ingredient": "garam-masala",
      "quantity": 3,
      "unit": "tsp"
    },
    {
      "id": "salt",
      "ingredient": "salt",
      "quantity": null,
      "unit": null
    },
    {
      "id": "oil",
      "ingredient": "vegetable-oil",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "id": "onion",
      "ingredient": "yellow-onion",
      "quantity": 1,
      "unit": "whole",
      "prep": "diced"
    },
    {
      "id": "garlic",
      "ingredient": "garlic",
      "quantity": 4,
      "unit": "clove",
