    }
  ],
  "steps": [
    {
      "text": "Toss the chicken with the yogurt, 1 tsp garam masala and 1 tsp salt. Let it sit while you start the rice.",
      "uses": ["chicken", "yogurt", "garam", "salt"]
    },
    {
      "text": "Rinse the rice, then bring it to a boil with 2¼ cups water and a pinch of salt. Cover, turn the heat to low and cook until the water is absorbed, about 15 minutes. Let it stand off the heat, still covered, while you cook.",
      "uses": ["rice"],
      "timerMinutes": 15
    },
    {
      "text": "Heat 1 tbsp oil in a large skillet over medium-high heat. Brown the chicken in batches, about 3 minutes per batch (it will finish in the sauce). Move to a plate.",
      "uses": ["oil"]
    },
    {
      "text": "Add the rest of the oil and the onion and cook until soft, 5 minutes. Stir in the garlic, ginger, turmeric and remaining garam masala for 1 minute.",
      "uses": ["onion", "garlic", "ginger", "turmeric"],
      "timerMinutes": 5
    },
    {
      "text": "Add the tomatoes and simmer for 5 minutes. Return the chicken and simmer until cooked through, 8 to 10 minutes. Stir in the cream and season with salt.",
      "uses": ["tomatoes", "cream"],
      "timerMinutes": 9
    },
    {
      "text": "Top with cilantro and serve over the rice.",
      "uses": ["cilantro"]
    }
  ]
}
