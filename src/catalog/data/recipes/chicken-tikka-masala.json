{
  "id": "chicken-tikka-masala",
  "title": "Weeknight Chicken Tikka Masala",
  "description": "Spiced yogurt-marinated chicken in a creamy tomato sauce. Serve with rice.",
  "image": null,
  "baseServings": 4,
  "prepMinutes": 15,
