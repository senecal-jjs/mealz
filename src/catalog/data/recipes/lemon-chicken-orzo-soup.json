  "steps": [
    {
      "text": "Heat the oil in a large pot over medium heat. Cook the onion, carrots and celery until softened, about 6 minutes.",
      "uses": ["oil", "onion", "carrots", "celery"],
      "timerMinutes": 6
    },
    {
      "text": "Add the garlic and cook for 1 minute.",
      "uses": ["garlic"]
    },
    {
      "text": "Add the broth and the whole chicken breasts. Simmer, covered, until the chicken is cooked through, about 12 minutes. Lift out the chicken and shred it with two forks.",
      "uses": ["broth", "chicken"],
      "timerMinutes": 12
    },
    {
      "text": "Add the orzo to the pot and simmer until tender, about 8 minutes.",
      "uses": ["orzo"],
      "timerMinutes": 8
    },
    {
      "text": "Return the chicken, stir in the spinach until wilted, then add the juice of the lemons. Season with salt and pepper.",
