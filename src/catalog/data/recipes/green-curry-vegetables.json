  "steps": [
    {
      "text": "Rinse the rice, then bring it to a boil with 2¼ cups water and a pinch of salt. Cover, turn the heat to low and cook until the water is absorbed, about 15 minutes. Let it stand off the heat, still covered, while you cook.",
      "uses": ["rice"],
      "timerMinutes": 15
    },
    {
      "text": "Heat the oil in a large pot over medium heat. Fry the curry paste, stirring, until fragrant, about 1 minute.",
      "uses": ["oil", "paste"]
    },
    {
      "text": "Stir in the coconut milk and bring to a simmer. Add the tofu, bell pepper and green beans and simmer until the vegetables are tender-crisp, about 6 minutes.",
      "uses": ["coconut", "tofu", "pepper", "beans"],
      "timerMinutes": 6
    },
    {
      "text": "Season with the soy sauce, brown sugar and juice of the lime. Stir in the basil and serve over rice.",
      "uses": ["soy", "sugar", "lime", "basil"]
    }
  ]
}
