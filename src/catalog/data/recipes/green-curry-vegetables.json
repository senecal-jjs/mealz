{
  "id": "green-curry-vegetables",
  "title": "Thai Green Curry with Vegetables",
  "description": "A fragrant coconut green curry with tofu, bell pepper and green beans over rice.",
  "image": null,
  "baseServings": 4,
  "prepMinutes": 10,
  "cookMinutes": 20,
  "difficulty": "easy",
  "tags": ["meatless", "spicy"],
  "reviewed": false,
  "ingredients": [
    {
      "id": "rice",
      "ingredient": "jasmine-rice",
      "quantity": 1.5,
      "unit": "cup"
    },
    {
      "id": "oil",
      "ingredient": "vegetable-oil",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "id": "paste",
      "ingredient": "green-curry-paste",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "id": "coconut",
      "ingredient": "coconut-milk",
      "quantity": 2,
      "unit": "can",
      "prep": "13.5 oz each"
    },
    {
      "id": "tofu",
      "ingredient": "extra-firm-tofu",
      "quantity": 14,
      "unit": "oz",
      "prep": "cubed"
    },
    {
      "id": "pepper",
      "ingredient": "bell-pepper",
      "quantity": 1,
      "unit": "whole",
      "prep": "sliced"
    },
    {
      "id": "beans",
      "ingredient": "green-beans",
      "quantity": 8,
      "unit": "oz",
      "prep": "trimmed and halved"
    },
    {
      "id": "soy",
      "ingredient": "soy-sauce",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "id": "sugar",
      "ingredient": "brown-sugar",
      "quantity": 1,
      "unit": "tsp"
    },
