  "steps": [
    {
      "text": "Heat the oil in a large, deep skillet over medium heat. Cook the onion and bell pepper with a pinch of salt until soft, about 6 minutes.",
      "uses": ["oil", "onion", "pepper", "salt"],
      "timerMinutes": 6
    },
    {
      "text": "Stir in the garlic, cumin and paprika for 1 minute.",
      "uses": ["garlic", "cumin", "paprika"]
    },
    {
      "text": "Add the tomatoes and simmer until thickened, about 10 minutes. Season with salt and black pepper.",
      "uses": ["tomatoes", "black-pepper"],
      "timerMinutes": 10
    },
    {
      "text": "Make 8 small wells in the sauce and crack an egg into each. Cover and cook on low until the whites are set but the yolks are still runny, 6 to 8 minutes.",
      "uses": ["eggs"],
      "timerMinutes": 7
    },
    {
      "text": "Top with feta and cilantro, and serve with bread for dipping.",
      "uses": ["feta", "cilantro", "bread"]
    }
  ]
