  "steps": [
    {
      "text": "Rinse the rice, then bring it to a boil with 2¼ cups water and a pinch of salt. Cover, turn the heat to low and cook until the water is absorbed, about 15 minutes. Let it stand off the heat, still covered, while you cook.",
      "uses": ["rice"],
      "timerMinutes": 15
    },
    {
      "text": "Season the chicken with salt and pepper. Sear in the oil in a large skillet over medium-high heat until browned and cooked through, about 5 minutes per side.",
      "uses": ["chicken", "salt", "pepper", "oil"],
      "timerMinutes": 10
    },
    {
      "text": "Lower the heat, add the garlic for 30 seconds, then the honey, soy sauce and vinegar. Simmer, turning the chicken, until sticky, about 3 minutes.",
      "uses": ["garlic", "honey", "soy", "vinegar"],
      "timerMinutes": 3
    },
    {
      "text": "Steam or microwave the green beans with a splash of water until crisp-tender, about 4 minutes.",
      "uses": ["beans"],
      "timerMinutes": 4
    },
    {
      "text": "Serve the chicken and sauce over rice with the beans, sprinkled with sesame seeds.",
      "uses": ["sesame"]
    }
  ]
}
