  "steps": [
    {
      "text": "Toss the shrimp with the paprika, oregano, chili powder and salt.",
      "uses": ["shrimp", "paprika", "oregano", "chili", "salt"]
    },
    {
      "text": "Heat the oil in a large skillet over high heat. Cook the corn and pepper, stirring only now and then, until charred in spots, about 5 minutes.",
      "uses": ["oil", "corn", "pepper"],
      "timerMinutes": 5
    },
    {
      "text": "Push the vegetables aside, add the butter, garlic and shrimp and cook, turning once, until the shrimp are pink, about 3 minutes.",
      "uses": ["butter", "garlic"],
      "timerMinutes": 3
    },
    {
