  "steps": [
    {
      "text": "Rinse the rice, then bring it to a boil with 2¼ cups water and a pinch of salt. Cover, turn the heat to low and cook until the water is absorbed, about 15 minutes. Let it stand off the heat, still covered, while you cook.",
      "uses": ["rice"],
      "timerMinutes": 15
    },
    {
      "text": "Toss the chicken with the curry powder and 1 tablespoon of the soy sauce.",
      "uses": ["chicken", "curry"]
    },
    {
      "text": "Cook in the oil in a large skillet over medium-high heat until charred and cooked through, about 8 minutes.",
      "uses": ["oil"],
      "timerMinutes": 8
    },
    {
      "text": "Warm the peanut butter, coconut milk, remaining soy sauce and the juice of the lime in a small pan, whisking until smooth.",
      "uses": ["pb", "coconut", "soy", "lime"],
      "timerMinutes": 2
    },
    {
      "text": "Toss the cucumber with the vinegar and chili. Serve the chicken over rice with the peanut sauce and cucumber salad.",
      "uses": ["cucumber", "vinegar", "chili"]
    }
  ]
}
