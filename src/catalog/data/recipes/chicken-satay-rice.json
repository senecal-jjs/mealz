{
  "id": "chicken-satay-rice",
  "title": "Chicken Satay with Cucumber Salad",
  "description": "Curry-spiced chicken with a quick peanut sauce, rice and a sharp cucumber salad.",
  "image": null,
  "baseServings": 4,
  "prepMinutes": 15,
  "cookMinutes": 15,
  "difficulty": "easy",
  "tags": ["kid-friendly"],
  "reviewed": false,
  "ingredients": [
