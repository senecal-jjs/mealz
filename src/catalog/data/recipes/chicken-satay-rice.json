      "ingredient": "jasmine-rice",
      "quantity": 1.5,
      "unit": "cup"
    },
    {
      "id": "chicken",
      "ingredient": "chicken-thighs",
      "quantity": 1.5,
      "unit": "lb",
      "prep": "cut into strips"
    },
    {
      "id": "curry",
      "ingredient": "curry-powder",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "id": "soy",
      "ingredient": "soy-sauce",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "id": "oil",
      "ingredient": "vegetable-oil",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "id": "pb",
      "ingredient": "peanut-butter",
      "quantity": 0.33,
      "unit": "cup"
    },
    {
      "id": "coconut",
      "ingredient": "coconut-milk",
      "quantity": 0.5,
      "unit": "can"
    },
    {
      "id": "lime",
      "ingredient": "lime",
      "quantity": 1,
      "unit": "whole"
    },
    {
      "id": "cucumber",
      "ingredient": "cucumber",
