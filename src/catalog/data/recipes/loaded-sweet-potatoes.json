  "steps": [
    {
      "text": "Prick the sweet potatoes all over with a fork and microwave on high until tender, 12 to 15 minutes, turning halfway.",
      "uses": ["potatoes"],
      "timerMinutes": 14
    },
    {
      "text": "Meanwhile, heat the oil in a skillet over medium heat. Cook the onion until soft, 4 minutes, then add the beans, cumin, chili powder, a pinch of salt and a splash of water. Warm through.",
      "uses": ["oil", "onion", "beans", "cumin", "chili", "salt"]
    },
    {
      "text": "Toss the avocado with the juice of half the lime and a pinch of salt.",
      "uses": ["avocado", "lime"]
    },
    {
      "text": "Split the potatoes, fluff the insides with a fork and fill with the beans, avocado, salsa and cilantro. Serve with lime wedges.",
      "uses": ["salsa", "cilantro"]
    }
  ]
