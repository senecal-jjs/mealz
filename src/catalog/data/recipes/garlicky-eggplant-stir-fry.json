  "steps": [
    {
      "text": "Rinse the rice, then bring it to a boil with 2¼ cups water and a pinch of salt. Cover, turn the heat to low and cook until the water is absorbed, about 15 minutes. Let it stand off the heat, still covered, while you cook.",
      "uses": ["rice"],
      "timerMinutes": 15
    },
    {
      "text": "Heat the oil in a large skillet over medium-high heat. Add the eggplant and a splash of water, cover and cook, stirring now and then, until soft and browned, about 10 minutes.",
      "uses": ["eggplant", "oil"],
      "timerMinutes": 10
    },
    {
      "text": "Add the garlic, ginger and chili and cook for 1 minute.",
      "uses": ["garlic", "ginger", "chili"]
    },
    {
      "text": "Whisk the soy sauce, brown sugar, vinegar and cornstarch with ⅓ cup water, pour it in and let it bubble until thick, about 1 minute.",
      "uses": ["soy", "sugar", "vinegar", "cornstarch"]
    },
    {
      "text": "Serve over rice, topped with green onions.",
      "uses": ["scallions"]
    }
  ]
}
