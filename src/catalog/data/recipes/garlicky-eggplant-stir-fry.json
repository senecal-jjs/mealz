{
  "id": "garlicky-eggplant-stir-fry",
  "title": "Garlicky Eggplant Stir-Fry",
  "description": "Silky eggplant in a sticky garlic-ginger sauce over rice.",
  "image": null,
  "baseServings": 4,
  "prepMinutes": 10,
  "cookMinutes": 20,
  "difficulty": "easy",
  "tags": ["stir-fry", "meatless"],
  "reviewed": false,
  "ingredients": [
    {
      "id": "rice",
      "ingredient": "jasmine-rice",
      "quantity": 1.5,
      "unit": "cup"
    },
    {
      "id": "eggplant",
      "ingredient": "eggplant",
      "quantity": 2,
      "unit": "whole",
      "prep": "cut into batons"
    },
    {
      "id": "oil",
      "ingredient": "vegetable-oil",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "id": "garlic",
      "ingredient": "garlic",
      "quantity": 5,
      "unit": "clove",
      "prep": "minced"
    },
    {
      "id": "ginger",
      "ingredient": "ginger",
      "quantity": 1,
      "unit": "tbsp",
      "prep": "grated"
    },
    {
      "id": "chili",
      "ingredient": "red-chili",
      "quantity": 1,
      "unit": "whole",
      "prep": "sliced",
      "optional": true
    },
    {
      "id": "soy",
      "ingredient": "soy-sauce",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "id": "sugar",
      "ingredient": "brown-sugar",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "id": "vinegar",
      "ingredient": "rice-vinegar",
