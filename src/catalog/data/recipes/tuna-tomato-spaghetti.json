  "steps": [
    {
      "text": "Cook the spaghetti in well-salted boiling water until al dente, about 10 minutes. Save 1 cup of the cooking water, then drain.",
      "uses": ["spaghetti", "salt"],
      "timerMinutes": 10
    },
    {
      "text": "Meanwhile, warm the oil, garlic and pepper flakes in a large skillet over medium heat for 1 minute. Add the tomatoes and cook until they burst, about 6 minutes, pressing some with a spoon.",
      "uses": ["oil", "garlic", "flakes", "tomatoes"],
      "timerMinutes": 6
    },
    {
      "text": "Stir in the tuna, olives and the zest and juice of the lemon.",
      "uses": ["tuna", "olives", "lemon"]
    },
    {
      "text": "Toss in the spaghetti with a splash of the cooking water until saucy. Finish with the parsley.",
      "uses": ["parsley"]
    }
