  "steps": [
    {
      "text": "Rinse the rice, then bring it to a boil with 2¼ cups water and a pinch of salt. Cover, turn the heat to low and cook until the water is absorbed, about 15 minutes. Let it stand off the heat, still covered, while you cook.",
      "uses": ["rice"],
      "timerMinutes": 15
    },
    {
      "text": "Toss the tofu with the cornstarch and fry in the oil in a large nonstick skillet over medium-high heat, turning, until crisp, about 8 minutes.",
      "uses": ["tofu", "cornstarch", "oil"],
      "timerMinutes": 8
    },
    {
      "text": "Add the broccoli and 2 tablespoons water, cover and cook until bright green, about 4 minutes.",
      "uses": ["broccoli"],
      "timerMinutes": 4
    },
    {
      "text": "Add the garlic and ginger for 30 seconds, then the soy sauce, maple syrup and ¼ cup water. Toss until glossy, about 1 minute.",
      "uses": ["garlic", "ginger", "soy", "maple"]
    },
    {
      "text": "Serve over rice with sesame seeds.",
      "uses": ["seeds"]
    }
  ]
