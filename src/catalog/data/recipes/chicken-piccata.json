  "steps": [
    {
      "text": "Season the cutlets with salt and pepper. Sear in the oil in a large skillet over medium-high heat until golden and cooked through, about 3 minutes per side. Set aside.",
      "uses": ["chicken", "salt", "pepper", "oil"],
      "timerMinutes": 6
    },
    {
      "text": "Steam or microwave the green beans until crisp-tender, about 4 minutes.",
      "uses": ["beans"],
      "timerMinutes": 4
    },
    {
      "text": "Lower the heat, melt 1 tablespoon of the butter in the skillet and cook the garlic for 30 seconds. Add the broth, the juice of the lemon and the capers and simmer until reduced by half, about 3 minutes.",
      "uses": ["butter", "garlic", "broth", "lemon", "capers"],
      "timerMinutes": 3
    },
    {
      "text": "Off the heat, swirl in the rest of the butter. Return the chicken, spoon over the sauce and scatter with parsley.",
      "uses": ["parsley"]
    }
  ]
