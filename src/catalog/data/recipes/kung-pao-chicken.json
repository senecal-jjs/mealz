  "steps": [
    {
      "text": "Rinse the rice, then bring it to a boil with 2¼ cups water and a pinch of salt. Cover, turn the heat to low and cook until the water is absorbed, about 15 minutes. Let it stand off the heat, still covered, while you cook.",
      "uses": ["rice"],
      "timerMinutes": 15
    },
    {
      "text": "Toss the chicken with the cornstarch and 1 tbsp soy sauce. Whisk the rest of the soy sauce with the vinegar, brown sugar and 2 tbsp water.",
      "uses": ["chicken", "cornstarch", "soy", "vinegar", "sugar"]
    },
    {
      "text": "Heat the oil in a wok or large skillet over high heat. Stir-fry the chicken until browned and cooked through, 5 to 6 minutes.",
      "uses": ["oil"],
      "timerMinutes": 6
    },
    {
      "text": "Add the pepper flakes, garlic, ginger and bell peppers and stir-fry for 2 minutes.",
      "uses": ["flakes", "garlic", "ginger", "pepper"]
    },
    {
      "text": "Pour in the sauce, add the green onions and peanuts and toss until glossy. Serve over rice.",
      "uses": ["scallions", "peanuts"]
    }
  ]
