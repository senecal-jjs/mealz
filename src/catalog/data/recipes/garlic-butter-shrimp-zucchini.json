  "steps": [
    {
      "text": "Pat the shrimp dry and season with salt and pepper.",
      "uses": ["shrimp", "salt", "pepper"]
    },
    {
      "text": "Heat the oil in a large skillet over medium-high heat. Cook the shrimp until pink, about 2 minutes per side, then move to a plate.",
      "uses": ["oil"]
    },
    {
      "text": "Lower the heat to medium and melt the butter. Add the garlic and pepper flakes and cook for 1 minute.",
      "uses": ["butter", "garlic", "flakes"]
    },
    {
      "text": "Add the zucchini and toss until just tender, 2 to 3 minutes. Return the shrimp, add the juice of the lemon and the parsley, and toss. Top with parmesan.",
