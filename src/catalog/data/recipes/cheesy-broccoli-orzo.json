  "steps": [
    {
      "text": "Melt the butter in a deep skillet over medium heat. Add the garlic and orzo and stir until the orzo smells toasty, about 2 minutes.",
      "uses": ["butter", "garlic", "orzo"]
    },
    {
      "text": "Pour in the broth and bring to a simmer. Cook, stirring often, for 6 minutes.",
