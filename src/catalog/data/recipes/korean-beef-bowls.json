  "steps": [
    {
      "text": "Rinse the rice, then bring it to a boil with 2¼ cups water and a pinch of salt. Cover, turn the heat to low and cook until the water is absorbed, about 15 minutes. Let it stand off the heat, still covered, while you cook.",
      "uses": ["rice"],
      "timerMinutes": 15
    },
    {
      "text": "Heat the sesame oil in a large skillet over medium-high heat. Cook the beef, breaking it up, until browned, 6 to 7 minutes. Spoon off excess fat.",
      "uses": ["oil", "beef"],
      "timerMinutes": 7
    },
    {
      "text": "Add the garlic and ginger for 1 minute, then stir in the soy sauce, brown sugar and pepper flakes and simmer for 2 minutes.",
      "uses": ["garlic", "ginger", "soy", "sugar", "flakes"]
    },
    {
      "text": "Serve over rice topped with green onions, cucumber and sesame seeds.",
      "uses": ["scallions", "cucumber", "sesame"]
    }
