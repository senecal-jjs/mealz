  "steps": [
    {
      "text": "Rinse the rice, then bring it to a boil with 2¼ cups water and a pinch of salt. Cover, turn the heat to low and cook until the water is absorbed, about 15 minutes. Let it stand off the heat, still covered, while you cook.",
      "uses": ["rice"],
      "timerMinutes": 15
    },
    {
      "text": "Heat the oil in a pot over medium heat and cook the onion until soft, about 5 minutes. Add the garlic, ginger, garam masala and turmeric and stir for 1 minute.",
      "uses": ["oil", "onion", "garlic", "ginger", "garam", "turmeric"],
      "timerMinutes": 5
    },
    {
      "text": "Add the lentils, tomatoes, coconut milk, 2 cups water and a big pinch of salt. Simmer, stirring often, until the lentils break down and the dal is thick, about 18 minutes.",
      "uses": ["lentils", "tomatoes", "coconut", "salt"],
      "timerMinutes": 18
    },
    {
      "text": "Stir in the spinach until wilted and add the juice of the lime. Serve over rice with cilantro.",
      "uses": ["spinach", "lime", "cilantro"]
    }
  ]
