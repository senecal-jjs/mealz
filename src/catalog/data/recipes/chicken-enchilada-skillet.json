{
  "id": "chicken-enchilada-skillet",
  "title": "Chicken Enchilada Skillet",
  "description": "The flavours of enchiladas (chicken, beans, corn tortillas and melted cheese) made in one skillet.",
  "image": null,
  "baseServings": 4,
  "prepMinutes": 10,
