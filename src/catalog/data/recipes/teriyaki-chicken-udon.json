      "quantity": 0.33,
      "unit": "cup"
    },
    {
      "id": "honey",
      "ingredient": "honey",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "id": "ginger",
      "ingredient": "ginger",
      "quantity": 1,
      "unit": "tbsp",
      "prep": "grated"
    },
    {
      "id": "garlic",
      "ingredient": "garlic",
      "quantity": 2,
      "unit": "clove",
      "prep": "grated"
    },
    {
      "id": "cornstarch",
      "ingredient": "cornstarch",
      "quantity": 1,
      "unit": "tsp"
    },
    {
