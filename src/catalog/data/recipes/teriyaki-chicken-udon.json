{
  "id": "teriyaki-chicken-udon",
  "title": "Teriyaki Chicken Udon",
  "description": "Thick, chewy udon tossed with chicken, broccoli and a glossy homemade teriyaki sauce.",
  "image": null,
  "baseServings": 4,
  "prepMinutes": 10,
