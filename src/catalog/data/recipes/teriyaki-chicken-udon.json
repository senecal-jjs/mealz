  "steps": [
    {
      "text": "Cook the udon in boiling water as the package directs, usually about 3 minutes. Drain and rinse briefly.",
      "uses": ["udon"],
      "timerMinutes": 3
    },
    {
      "text": "Whisk the soy sauce, honey, ginger, garlic and cornstarch with 2 tablespoons water.",
      "uses": ["soy", "honey", "ginger", "garlic", "cornstarch"]
    },
    {
      "text": "Heat the oil in a large skillet or wok over medium-high heat. Brown the chicken until cooked through, about 6 minutes.",
      "uses": ["chicken", "oil"],
      "timerMinutes": 6
    },
    {
      "text": "Add the broccoli and a splash of water, cover and steam until bright green, about 3 minutes.",
      "uses": ["broccoli"],
      "timerMinutes": 3
    },
    {
      "text": "Add the sauce and noodles and toss until glossy, 1 to 2 minutes. Top with green onions and sesame seeds.",
      "uses": ["scallions", "sesame"]
    }
  ]
}
