  "steps": [
    {
      "text": "Heat the oil in a large pot over medium heat. Cook the onion and pepper until soft, about 6 minutes.",
      "uses": ["oil", "onion", "pepper"],
      "timerMinutes": 6
    },
    {
      "text": "Add the garlic, cumin and paprika and cook for 1 minute.",
      "uses": ["garlic", "cumin", "paprika"]
    },
    {
      "text": "Add the beans and broth and simmer for 12 minutes. Blend about half the soup (or use a stick blender briefly) so it's thick but still chunky.",
      "uses": ["beans", "broth"],
      "timerMinutes": 12
    },
    {
      "text": "Season with salt and the juice of the lime.",
      "uses": ["salt", "lime"]
    },
    {
      "text": "Serve topped with avocado, cilantro and sour cream.",
      "uses": ["avocado", "cilantro", "sour"]
    }
  ]
