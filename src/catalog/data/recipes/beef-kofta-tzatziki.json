  "steps": [
    {
      "text": "Mix the beef with half the onion, half the garlic, the cumin, coriander, cinnamon, salt and half the parsley. Shape into 12 small logs.",
      "uses": ["beef", "onion", "garlic", "cumin", "coriander", "cinnamon", "salt", "parsley"]
    },
    {
      "text": "Cook the kofta in the oil in a large skillet over medium-high heat, turning, until browned and cooked through, about 10 minutes.",
      "uses": ["oil"],
      "timerMinutes": 10
    },
    {
      "text": "Grate half the cucumber, squeeze it dry and stir it into the yogurt with the rest of the garlic and a pinch of salt.",
      "uses": ["yogurt", "cucumber"]
    },
    {
      "text": "Chop the rest of the cucumber and toss with the tomatoes, the rest of the onion and parsley, and the juice of the lemon.",
      "uses": ["tomatoes", "lemon"]
    },
    {
      "text": "Warm the pitas and serve with the kofta, salad and tzatziki.",
