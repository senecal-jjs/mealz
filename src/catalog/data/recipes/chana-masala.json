  "steps": [
    {
      "text": "Rinse the rice, then bring it to a boil with 2¼ cups water and a pinch of salt. Cover, turn the heat to low and cook until the water is absorbed, about 15 minutes. Let it stand off the heat, still covered, while you cook.",
      "uses": ["rice"],
      "timerMinutes": 15
    },
    {
      "text": "Heat the oil in a large pot over medium heat. Cook the onion until golden, about 7 minutes.",
      "uses": ["oil", "onion"],
      "timerMinutes": 7
    },
    {
      "text": "Stir in the garlic, ginger, chili, garam masala, cumin and turmeric for 1 minute.",
      "uses": ["garlic", "ginger", "chili", "garam", "cumin", "turmeric"]
    },
    {
      "text": "Add the tomatoes, chickpeas, ½ cup water and a good pinch of salt. Simmer, partly covered, until thick, about 15 minutes. Mash a few chickpeas to thicken the sauce.",
      "uses": ["tomatoes", "chickpeas", "salt"],
      "timerMinutes": 15
    },
    {
      "text": "Finish with the juice of the lemon and the cilantro. Serve over rice.",
      "uses": ["lemon", "cilantro"]
    }
  ]
}
