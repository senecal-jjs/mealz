{
  "id": "sheet-pan-chicken-fajitas",
  "title": "Sheet-Pan Chicken Fajitas",
  "description": "Smoky spiced chicken and peppers roasted on one pan, then piled into warm tortillas.",
  "image": null,
  "baseServings": 4,
