  "steps": [
    {
      "text": "Heat the oven to 425°F (220°C) and line a large sheet pan with parchment or foil.",
      "uses": []
    },
    {
      "text": "Pile the chicken, peppers and onion on the pan. Add the oil, chili powder, cumin, paprika and a big pinch of salt, toss with your hands and spread into a single layer.",
      "uses": ["chicken", "pepper", "onion", "oil", "chili", "cumin", "paprika", "salt"]
    },
    {
      "text": "Roast until the chicken is cooked through and the peppers are soft and charred at the edges, about 20 minutes.",
      "uses": [],
      "timerMinutes": 20
    },
    {
      "text": "For the last 5 minutes, wrap the tortillas in foil and warm them on the lower rack.",
      "uses": ["tortillas"]
    },
    {
      "text": "Squeeze a couple of lime wedges over the pan. Fill the tortillas and top with sour cream and cilantro, with the rest of the lime on the side.",
      "uses": ["lime", "sour-cream", "cilantro"]
    }
  ]
