  "steps": [
    {
      "text": "Warm the beans with the cumin, salt and a splash of water in a small pan, mashing them roughly, about 5 minutes.",
      "uses": ["beans", "cumin", "salt"],
      "timerMinutes": 5
    },
    {
      "text": "Heat a little of the oil in a large skillet and crisp the tortillas, about 1 minute per side. Keep them warm.",
      "uses": ["oil", "tortillas"],
      "timerMinutes": 2
