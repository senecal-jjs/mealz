  "steps": [
    {
      "text": "Rinse the rice, then bring it to a boil with 2¼ cups water and a pinch of salt. Cover, turn the heat to low and cook until the water is absorbed, about 15 minutes. Let it stand off the heat, still covered, while you cook.",
      "uses": ["rice"],
      "timerMinutes": 15
    },
    {
      "text": "Heat the oil in a large pot over medium heat. Cook the onion with a pinch of salt until soft and golden, about 5 minutes.",
      "uses": ["oil", "onion", "salt"],
      "timerMinutes": 5
    },
    {
      "text": "Add the garlic, ginger and curry powder and stir until fragrant, about 1 minute.",
      "uses": ["garlic", "ginger", "curry"]
    },
    {
      "text": "Add the chickpeas, tomatoes and coconut milk. Simmer, stirring now and then, until slightly thickened, about 10 minutes.",
      "uses": ["chickpeas", "tomatoes", "coconut"],
      "timerMinutes": 10
    },
    {
      "text": "Stir in the spinach until it wilts. Season with salt and a squeeze of lime, and serve over the rice.",
      "uses": ["spinach", "lime"]
    }
  ]
}
