  "steps": [
    {
      "text": "Toss the zucchini with ½ teaspoon salt and leave for 10 minutes. Squeeze out as much liquid as you can in a clean towel.",
      "uses": ["zucchini", "salt"],
      "timerMinutes": 10
    },
    {
      "text": "Mix the zucchini with the eggs, panko, feta, green onions and garlic.",
      "uses": ["eggs", "panko", "feta", "scallions", "garlic"]
    },
    {
      "text": "Heat the oil in a large skillet over medium heat. Drop in heaped spoonfuls, flatten and fry until golden, about 3 minutes per side.",
      "uses": ["oil"],
      "timerMinutes": 6
