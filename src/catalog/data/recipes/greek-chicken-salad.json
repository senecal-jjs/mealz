      "timerMinutes": 12
    },
    {
      "text": "Whisk the remaining oil and oregano with the vinegar and the juice of the lemon.",
      "uses": ["oil", "oregano", "vinegar", "lemon"]
    },
    {
      "text": "Toss the romaine, cucumber, tomatoes, onion and olives with the dressing.",
      "uses": ["romaine", "cucumber", "tomatoes", "onion", "olives"]
    },
    {
