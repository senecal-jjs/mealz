  "steps": [
    {
      "text": "Cook the soba in boiling water for about 4 minutes, adding the edamame for the last minute. Drain and rinse under cold water until cool.",
      "uses": ["soba", "edamame"],
      "timerMinutes": 4
    },
    {
      "text": "Whisk the tahini, soy sauce, vinegar, maple syrup, sesame oil and ginger with 2 tablespoons water until smooth.",
      "uses": ["tahini", "soy", "vinegar", "maple", "sesameoil", "ginger"]
    },
    {
      "text": "Toss the noodles and edamame with the dressing, cucumber and carrots.",
      "uses": ["cucumber", "carrots"]
    },
    {
      "text": "Top with green onions and sesame seeds. Serve cold or at room temperature.",
