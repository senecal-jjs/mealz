  "steps": [
    {
      "text": "Make the salsa: toss the mango, onion and half the cilantro with the juice of 1 lime and a pinch of salt.",
      "uses": ["mango", "onion", "cilantro", "lime", "salt"]
    },
    {
      "text": "Pat the shrimp dry and toss with the chili powder, cumin and a pinch of salt.",
      "uses": ["shrimp", "chili", "cumin"]
    },
    {
      "text": "Heat the oil in a large skillet over high heat. Cook the shrimp until pink and just cooked through, about 2 minutes per side.",
      "uses": ["oil"]
    },
    {
      "text": "Warm the tortillas in a dry skillet.",
      "uses": ["tortillas"]
    },
    {
      "text": "Fill the tortillas with cabbage, shrimp and salsa. Add a spoonful of sour cream and serve with the other lime in wedges.",
