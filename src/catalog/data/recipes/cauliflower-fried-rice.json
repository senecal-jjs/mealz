  "steps": [
    {
      "text": "Heat 2 tbsp oil in a large nonstick skillet over medium-high heat. Fry the tofu until golden on most sides, 8 to 10 minutes, then move to a plate.",
      "uses": ["tofu", "oil"],
      "timerMinutes": 9
    },
    {
      "text": "Add the remaining oil, the garlic, ginger and white parts of the green onions, and stir for 30 seconds.",
      "uses": ["garlic", "ginger", "scallions"]
    },
    {
      "text": "Add the peas and carrots and the cauliflower rice. Cook, stirring, until hot and any liquid has cooked off, about 5 minutes.",
      "uses": ["veg", "cauli"],
      "timerMinutes": 5
    },
    {
      "text": "Stir in the soy sauce, sesame oil and tofu, and top with the green onion tops.",
      "uses": ["soy", "sesame"]
    }
