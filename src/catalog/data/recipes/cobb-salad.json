      "timerMinutes": 6
    },
    {
      "text": "Cook the bacon in the same skillet until crisp, then drain on paper towels and crumble.",
      "uses": ["bacon"]
    },
    {
      "text": "Meanwhile, simmer the eggs for 9 minutes, cool in cold water, then peel and chop.",
      "uses": ["eggs"],
      "timerMinutes": 9
    },
    {
      "text": "Whisk ¼ cup oil with the vinegar, mustard and a pinch of salt and pepper.",
      "uses": ["oil-dressing", "vinegar", "mustard"]
