  "steps": [
    {
      "text": "Rinse the rice, then bring it to a boil with 2¼ cups water and a pinch of salt. Cover, turn the heat to low and cook until the water is absorbed, about 15 minutes. Let it stand off the heat, still covered, while you cook.",
      "uses": ["rice"],
      "timerMinutes": 15
    },
    {
      "text": "Whisk the soy sauce, honey, vinegar and ginger. Cook the edamame in boiling water or the microwave until hot.",
      "uses": ["soy", "honey", "vinegar", "ginger", "edamame"]
    },
    {
      "text": "Season the salmon lightly with salt. Heat the oil in a nonstick skillet over medium-high heat and sear the salmon until golden, about 4 minutes. Flip and cook 2 minutes more.",
      "uses": ["salmon", "salt", "oil"],
      "timerMinutes": 4
    },
    {
      "text": "Pour in the sauce and let it bubble, spooning it over the fish, until syrupy, about 1 minute.",
      "uses": []
    },
    {
      "text": "Serve the salmon over rice with the edamame and cucumber, topped with green onions and sesame seeds.",
      "uses": ["cucumber", "scallions", "sesame"]
    }
  ]
