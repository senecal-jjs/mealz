      "ingredient": "maple-syrup",
      "quantity": 0.25,
      "unit": "cup",
      "prep": "for serving"
    }
  ],
  "steps": [
    {
      "text": "Blend the oats until they look like flour. Add 2 of the bananas, the milk, eggs, baking powder, cinnamon and a pinch of salt and blend until smooth. Let the batter rest for 5 minutes to thicken.",
      "uses": ["oats", "bananas", "milk", "eggs", "powder", "cinnamon", "salt"],
      "timerMinutes": 5
    },
    {
      "text": "Heat a nonstick skillet over medium heat and melt a little butter. Pour in ¼-cup portions and cook until bubbles form on top, 2 to 3 minutes, then flip and cook 1 to 2 minutes more. Repeat with the rest of the batter.",
      "uses": ["butter"],
      "timerMinutes": 3
    },
    {
      "text": "Serve topped with the last banana, sliced, and the maple syrup.",
      "uses": ["maple"]
    }
  ]
}
