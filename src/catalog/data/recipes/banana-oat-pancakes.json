{
  "id": "banana-oat-pancakes",
  "title": "Banana Oat Pancakes",
  "description": "Blender pancakes made from oats, banana and milk: fluffy, naturally sweet and good fuel before a long ride or run.",
  "image": null,
  "baseServings": 4,
  "prepMinutes": 5,
  "cookMinutes": 15,
  "difficulty": "easy",
  "tags": ["meatless", "kid-friendly", "quick", "high-carb"],
  "reviewed": false,
  "ingredients": [
    {
      "id": "oats",
      "ingredient": "rolled-oats",
      "quantity": 2,
      "unit": "cup"
    },
    {
      "id": "bananas",
      "ingredient": "banana",
      "quantity": 3,
      "unit": "whole",
      "prep": "ripe; 1 for serving"
    },
    {
      "id": "milk",
      "ingredient": "milk",
      "quantity": 1.25,
      "unit": "cup"
    },
    {
      "id": "eggs",
      "ingredient": "egg",
      "quantity": 2,
      "unit": "whole"
    },
    {
      "id": "powder",
      "ingredient": "baking-powder",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "id": "cinnamon",
      "ingredient": "ground-cinnamon",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "id": "salt",
      "ingredient": "salt",
      "quantity": null,
      "unit": null
    },
    {
      "id": "butter",
      "ingredient": "butter",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
