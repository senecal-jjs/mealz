  "steps": [
    {
      "text": "Heat the oil in a large pot over medium heat. Cook the onion, carrots and celery until soft, about 6 minutes. Add the garlic for 1 minute.",
      "uses": ["oil", "onion", "carrots", "celery", "garlic"],
      "timerMinutes": 6
    },
    {
      "text": "Add the beef and a good pinch of salt and cook, breaking it up, until browned, about 6 minutes. Stir in the tomato paste for 1 minute.",
      "uses": ["beef", "salt", "paste"],
      "timerMinutes": 6
    },
    {
      "text": "Add the tomatoes and oregano and simmer, stirring now and then, for 15 minutes. Stir in the cream if using.",
      "uses": ["tomatoes", "oregano", "cream"],
      "timerMinutes": 15
    },
    {
      "text": "Meanwhile, cook the spaghetti in salted boiling water until al dente, then drain. Toss with the sauce and serve with parmesan.",
      "uses": ["pasta", "parmesan"]
    }
  ]
