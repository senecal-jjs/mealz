  "steps": [
    {
      "text": "Cook the pasta in a large pot of salted boiling water until al dente, 10 to 11 minutes. Save ½ cup of the pasta water, then drain.",
      "uses": ["pasta", "salt"],
      "timerMinutes": 11
    },
    {
      "text": "Meanwhile, season the chicken with salt and pepper. Heat the oil in a large skillet over medium-high heat and cook the chicken until golden and cooked through, 6 to 8 minutes.",
      "uses": ["chicken", "pepper", "oil"],
      "timerMinutes": 8
    },
    {
      "text": "Add the tomatoes and cook until just softening, about 2 minutes. Add the spinach and stir until wilted.",
      "uses": ["tomatoes", "spinach"]
    },
    {
      "text": "Add the pasta, pesto and a splash of the pasta water and toss until glossy. Top with parmesan.",
