  "steps": [
    {
      "text": "Cook the pasta in salted boiling water until al dente, about 10 minutes, then drain.",
      "uses": ["pasta", "salt"],
      "timerMinutes": 10
    },
    {
      "text": "Meanwhile, heat the butter and oil in a large skillet over medium-high heat. Cook the mushrooms without stirring for 3 minutes, then stir and cook until well browned, about 5 minutes more.",
      "uses": ["butter", "oil", "mushrooms"],
      "timerMinutes": 8
    },
    {
      "text": "Add the onion and cook until soft, 4 minutes. Stir in the garlic and paprika for 30 seconds.",
      "uses": ["onion", "garlic", "paprika"],
      "timerMinutes": 4
    },
    {
      "text": "Add the broth and mustard and simmer for 3 minutes. Take the pan off the heat and stir in the sour cream. Season with salt and pepper.",
      "uses": ["broth", "mustard", "sour-cream", "pepper"]
    },
    {
      "text": "Serve over the pasta, topped with parsley.",
      "uses": ["parsley"]
    }
  ]
