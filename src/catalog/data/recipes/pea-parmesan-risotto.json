      "quantity": null,
      "unit": null
    }
  ],
  "steps": [
    {
      "text": "Warm the broth in a small pot over low heat.",
      "uses": ["broth"]
    },
    {
      "text": "Melt 2 tablespoons of the butter in a wide pot over medium heat and cook the onion until soft, about 4 minutes.",
      "uses": ["butter", "onion"],
      "timerMinutes": 4
    },
    {
      "text": "Add the garlic and rice and stir for 2 minutes, until the rice edges look translucent.",
      "uses": ["garlic", "rice"],
      "timerMinutes": 2
    },
    {
      "text": "Add the broth a ladle at a time, stirring often and letting each addition be absorbed before the next, until the rice is creamy and just tender, about 20 minutes.",
      "uses": [],
      "timerMinutes": 20
    },
    {
      "text": "Stir in the peas for 2 minutes. Off the heat, beat in the rest of the butter, the parmesan, and the zest and juice of the lemon. Season with salt and pepper.",
      "uses": ["peas", "parmesan", "lemon", "salt", "pepper"]
    }
  ]
}
