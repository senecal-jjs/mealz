{
  "id": "pea-parmesan-risotto",
  "title": "Pea and Parmesan Risotto",
  "description": "Creamy stirred risotto with sweet peas, lemon and parmesan.",
  "image": null,
  "baseServings": 4,
  "prepMinutes": 5,
  "cookMinutes": 30,
  "difficulty": "medium",
  "tags": ["meatless", "high-carb"],
  "reviewed": false,
  "ingredients": [
    {
      "id": "broth",
      "ingredient": "vegetable-broth",
      "quantity": 6,
      "unit": "cup"
    },
    {
      "id": "butter",
      "ingredient": "butter",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "id": "onion",
      "ingredient": "yellow-onion",
      "quantity": 1,
      "unit": "whole",
      "prep": "finely chopped"
    },
    {
      "id": "garlic",
      "ingredient": "garlic",
      "quantity": 2,
      "unit": "clove",
      "prep": "minced"
    },
    {
      "id": "rice",
      "ingredient": "arborio-rice",
      "quantity": 1.5,
      "unit": "cup"
    },
    {
      "id": "peas",
      "ingredient": "frozen-peas",
      "quantity": 1.5,
      "unit": "cup"
    },
    {
      "id": "parmesan",
      "ingredient": "parmesan",
      "quantity": 0.75,
      "unit": "cup",
      "prep": "grated"
    },
    {
      "id": "lemon",
      "ingredient": "lemon",
      "quantity": 1,
      "unit": "whole"
    },
    {
      "id": "salt",
      "ingredient": "salt",
      "quantity": null,
      "unit": null
    },
