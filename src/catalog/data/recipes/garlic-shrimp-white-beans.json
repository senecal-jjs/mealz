  "steps": [
    {
      "text": "Warm the oil, garlic and pepper flakes in a large skillet over medium heat until the garlic is fragrant, about 1 minute.",
      "uses": ["oil", "garlic", "flakes"]
    },
    {
      "text": "Add the shrimp with a pinch of salt and cook until pink, about 3 minutes. Lift them out.",
      "uses": ["shrimp", "salt"],
      "timerMinutes": 3
    },
    {
      "text": "Add the tomatoes, beans and broth and simmer for 4 minutes.",
      "uses": ["tomatoes", "beans", "broth"],
      "timerMinutes": 4
    },
    {
      "text": "Stir in the spinach until wilted, return the shrimp and add the juice of the lemon and the parsley. Serve with crusty bread.",
      "uses": ["spinach", "lemon", "parsley", "bread"]
    }
  ]
