  "steps": [
    {
      "text": "Bring the quinoa, 3 cups water and a pinch of salt to a boil. Cover and simmer on low until the water is absorbed, about 15 minutes. Rest 5 minutes, then fluff.",
      "uses": ["quinoa", "salt"],
      "timerMinutes": 15
    },
    {
      "text": "Pat the chickpeas dry. Fry them in a skillet with 1 tbsp of the oil and the oregano over medium-high heat until crisp in spots, 6 to 8 minutes.",
      "uses": ["chickpeas", "oregano", "oil"],
      "timerMinutes": 8
    },
    {
      "text": "Whisk the rest of the oil with the juice of both lemons, the garlic and a good pinch of salt and pepper.",
      "uses": ["lemon", "garlic", "pepper"]
    },
    {
      "text": "Toss the cucumber, tomatoes, onion, olives and parsley with about a third of the dressing.",
      "uses": ["cucumber", "tomatoes", "onion", "olives", "parsley"]
    },
    {
      "text": "Divide the quinoa between bowls, top with the salad, chickpeas and feta, and drizzle with the remaining dressing.",
      "uses": ["feta"]
    }
