      "ingredient": "garlic",
      "quantity": 3,
      "unit": "clove",
      "prep": "minced"
    },
    {
      "id": "paste",
      "ingredient": "tomato-paste",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "id": "lentils",
      "ingredient": "red-lentils",
      "quantity": 1,
      "unit": "cup",
      "prep": "rinsed"
    },
    {
      "id": "tomatoes",
      "ingredient": "crushed-tomatoes",
