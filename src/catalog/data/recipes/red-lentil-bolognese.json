      "ingredient": "basil",
      "quantity": 0.5,
      "unit": "bunch",
      "optional": true
    }
  ],
  "steps": [
    {
      "text": "Heat the oil in a large pot over medium heat. Cook the onion and carrots until soft, about 6 minutes.",
      "uses": ["oil", "onion", "carrots"],
      "timerMinutes": 6
    },
    {
      "text": "Stir in the garlic and tomato paste for 1 minute.",
      "uses": ["garlic", "paste"]
    },
    {
      "text": "Add the lentils, tomatoes, oregano, 2 cups water and a good pinch of salt. Simmer, stirring often, until the lentils are soft and the sauce is thick, about 20 minutes.",
      "uses": ["lentils", "tomatoes", "oregano", "salt"],
      "timerMinutes": 20
    },
    {
      "text": "Meanwhile, cook the spaghetti in salted boiling water until al dente, about 10 minutes, and drain.",
      "uses": ["spaghetti"],
      "timerMinutes": 10
    },
    {
      "text": "Toss the spaghetti with the sauce and top with torn basil.",
      "uses": ["basil"]
    }
  ]
}
