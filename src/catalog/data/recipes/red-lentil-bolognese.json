{
  "id": "red-lentil-bolognese",
  "title": "Red Lentil Bolognese",
  "description": "A rich, meat-free bolognese where red lentils cook down into the tomato sauce.",
  "image": null,
  "baseServings": 4,
  "prepMinutes": 10,
  "cookMinutes": 25,
  "difficulty": "easy",
  "tags": ["meatless", "budget", "meal-prep", "high-carb"],
  "reviewed": false,
  "ingredients": [
