  "steps": [
    {
      "text": "Season the chicken with salt, pepper and thyme. Heat 1 tbsp oil in a large skillet over medium-high heat and cook until golden and cooked through, 5 to 6 minutes per side. Move to a plate.",
      "uses": ["chicken", "salt", "pepper", "thyme", "oil"],
      "timerMinutes": 6
    },
    {
      "text": "Add the remaining oil and the asparagus with a pinch of salt. Cook, turning, until bright green and tender-crisp, 4 to 5 minutes. Move to the plate.",
      "uses": ["asparagus"],
      "timerMinutes": 5
    },
    {
      "text": "Lower the heat, melt the butter and cook the garlic for 30 seconds. Add the broth and the juice of the lemon and simmer until slightly reduced, about 2 minutes.",
      "uses": ["butter", "garlic", "broth", "lemon"]
    },
    {
      "text": "Spoon the sauce over the chicken and asparagus and top with parsley.",
      "uses": ["parsley"]
    }
