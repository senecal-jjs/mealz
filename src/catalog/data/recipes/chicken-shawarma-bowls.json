  "steps": [
    {
      "text": "Heat the oven to 450°F (230°C). Toss the chicken with 2 tbsp oil, the cumin, coriander, paprika, turmeric, the juice of 1 lemon and 1 tsp salt. Spread on a sheet pan.",
      "uses": ["chicken", "oil", "cumin", "coriander", "paprika", "turmeric", "lemon", "salt"]
    },
    {
      "text": "Roast until charred at the edges and cooked through, about 20 minutes.",
      "uses": [],
      "timerMinutes": 20
    },
    {
      "text": "Rinse the rice, then bring it to a boil with 2¼ cups water and a pinch of salt. Cover, turn the heat to low and cook until the water is absorbed, about 15 minutes. Let it stand off the heat, still covered, while you cook.",
      "uses": ["rice"],
      "timerMinutes": 15
    },
    {
      "text": "Stir the yogurt with the garlic, a squeeze of lemon and a pinch of salt.",
      "uses": ["yogurt", "garlic"]
    },
    {
      "text": "Toss the cucumber, tomatoes, onion and parsley with the remaining oil and lemon juice.",
      "uses": ["cucumber", "tomatoes", "onion", "parsley"]
    },
    {
      "text": "Slice the chicken and serve over rice with the salad and a spoonful of garlic yogurt.",
      "uses": []
    }
