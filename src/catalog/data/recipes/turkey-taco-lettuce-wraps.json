  "steps": [
    {
      "text": "Heat the oil in a large skillet over medium-high heat. Cook the onion and bell pepper until softened, about 4 minutes.",
      "uses": ["oil", "onion", "pepper"],
      "timerMinutes": 4
    },
    {
      "text": "Add the turkey and cook, breaking it up, until no longer pink, 6 to 7 minutes.",
      "uses": ["turkey"],
      "timerMinutes": 7
    },
    {
      "text": "Stir in the garlic, chili powder, cumin, 1 tsp salt and ¼ cup water. Simmer until saucy, about 2 minutes.",
      "uses": ["garlic", "chili", "cumin", "salt"]
    },
    {
      "text": "Squeeze in the juice of half the lime. Spoon the filling into lettuce cups and top with tomatoes, avocado and cheddar. Serve with the rest of the lime in wedges.",
