  "steps": [
    {
      "text": "Toss the tofu with the cornstarch. Fry in the oil in a large nonstick skillet over medium-high heat, turning, until crisp on all sides, about 10 minutes.",
      "uses": ["tofu", "cornstarch", "oil"],
      "timerMinutes": 10
    },
    {
      "text": "Add the snap peas and stir-fry until bright green, about 2 minutes.",
      "uses": ["snap"],
      "timerMinutes": 2
    },
    {
      "text": "Add the garlic and ginger for 30 seconds.",
      "uses": ["garlic", "ginger"]
    },
    {
      "text": "Pour in the soy sauce, maple syrup, vinegar and sesame oil and toss until glossy, about 1 minute. Sprinkle with sesame seeds.",
