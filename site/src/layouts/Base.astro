---
import { iconUrl } from '../app-data';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2F9E6E" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/png" href={iconUrl} />
    <link rel="apple-touch-icon" href={iconUrl} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={base}>
          <img src={iconUrl} alt="" width="36" height="36" />
          <span>Mealz</span>
        </a>
        <nav aria-label="Site">
          <a href={`${base}#features`}>Features</a>
          <a href={`${base}privacy/`}>Privacy</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <p>Mealz, a meal planner for your phone.</p>
        <p><a href={`${base}privacy/`}>Privacy policy</a></p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --green: #2f9e6e;
    --green-strong: #23805a;
    --green-soft: #e3f3eb;
    --text: #1d2420;
    --muted: #5b655f;
    --bg: #fffaf4;
    --surface: #ffffff;
    --surface-warm: #f6e7d8;
    --line: #eadfd3;
    --focus: #1b6e4c;
    --radius: 20px;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --green: #3dba84;
      --green-strong: #5fd09d;
      --green-soft: #183327;
      --text: #eef2ef;
      --muted: #a6b0aa;
      --bg: #101512;
      --surface: #18201b;
      --surface-warm: #1f2622;
      --line: #2a332e;
      --focus: #7fe0b3;
    }
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font:
      17px/1.55 -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      Roboto,
      sans-serif;
  }
  img {
    max-width: 100%;
    height: auto;
    display: block;
  }
  a {
    color: var(--green-strong);
  }
  :focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
    border-radius: 6px;
  }
  h1,
  h2,
  h3 {
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .wrap {
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 16px;
  }
  @media (min-width: 640px) {
    .wrap {
      padding: 0 24px;
    }
  }
  .skip {
    position: absolute;
    left: 8px;
    top: -48px;
    padding: 8px 12px;
    background: var(--surface);
    border-radius: 8px;
    z-index: 10;
  }
  .skip:focus {
    top: 8px;
  }
  .site-header {
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    text-decoration: none;
    font-weight: 700;
    font-size: 20px;
  }
  .brand img {
    border-radius: 9px;
  }
  nav {
    display: flex;
    gap: 4px;
  }
  nav a {
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
    padding: 10px 12px;
    border-radius: 10px;
  }
  nav a:hover {
    background: var(--green-soft);
  }
  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: 64px;
    color: var(--muted);
    font-size: 15px;
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 24px;
    padding-top: 16px;
    padding-bottom: 24px;
  }
  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }
</style>
