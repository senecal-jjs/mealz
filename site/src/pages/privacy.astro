---
// The policy's single source is docs/privacy-policy.html in the app repo; this page shows its
// <main> content inside the site layout.
import Base from '../layouts/Base.astro';
import policy from '../../../docs/privacy-policy.html?raw';

const main = policy.match(/<main>([\s\S]*?)<\/main>/)?.[1];
if (!main) throw new Error('docs/privacy-policy.html has no <main> element');

const PLACEHOLDER = 'CONTACT_EMAIL';
const hasPlaceholder = main.includes(PLACEHOLDER);
if (hasPlaceholder) {
  console.warn(`[privacy] ${PLACEHOLDER} is still a placeholder in docs/privacy-policy.html`);
}
// Make the unfilled placeholder impossible to miss on the page.
const body = main.replace(
  />CONTACT_EMAIL</g,
  '><mark class="placeholder" title="Placeholder: replace in docs/privacy-policy.html">CONTACT_EMAIL</mark><',
);
---

<Base
  title="Mealz Privacy Policy"
  description="How Mealz handles your information: no accounts, no tracking, and your data stays on your phone.">
  <article class="wrap policy">
    <Fragment set:html={body} />
  </article>
</Base>

<style>
  .policy {
    max-width: 720px;
    padding-top: 40px;
  }
  .policy :global(h1) {
    font-size: clamp(32px, 8vw, 44px);
    margin: 0 0 4px;
  }
  .policy :global(h2) {
    font-size: 22px;
    margin: 36px 0 8px;
  }
  .policy :global(.muted) {
    color: var(--muted);
  }
  .policy :global(mark.placeholder) {
    background: #ffd84d;
    color: #1d2420;
    padding: 0 4px;
    border-radius: 4px;
  }
</style>
