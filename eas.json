{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "internal": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_INCLUDE_DRAFTS": "true",
        "EXPO_PUBLIC_SCAN_SERVER_URL": "https://mealz-scan.fly.dev"
      },
      "autoIncrement": true
    },
    "preview": {
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_INCLUDE_DRAFTS": "true",
        "EXPO_PUBLIC_SCAN_SERVER_URL": "https://mealz-scan.fly.dev"
      },
      "autoIncrement": true
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_INCLUDE_DRAFTS": "false",
        "EXPO_PUBLIC_SCAN_SERVER_URL": "https://mealz-scan.fly.dev"
      }
    }
  },
  "submit": {
    "preview": {},
    "production": {}
  }
}
